{
  "name": "tft-twitch-extension",
  "version": "1.0.0",
  "private": true,
  "description": "TFT Live Client Data to Twitch Video Overlay Extension",
  "workspaces": [
    "ebs",
    "viewer-overlay",
    "desktop-app"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "scripts": {
    "test": "pnpm run test:obs && pnpm run test:ebs && pnpm run test:viewer && pnpm run test:desktop",
    "test:obs": "python3 -m unittest discover -s obs-script -p 'test_*.py'",
    "test:ebs": "pnpm --filter tft-twitch-ebs test",
    "test:viewer": "pnpm --filter tft-twitch-viewer-overlay test",
    "test:desktop": "pnpm --filter tft-desktop-app test",
    "build:ebs": "pnpm --filter tft-twitch-ebs run build",
    "build:desktop": "pnpm --filter tft-desktop-app run build"
  }
}
